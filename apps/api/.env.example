ENV=development
LOG_LEVEL=INFO
# mnemo_app is a dedicated, non-superuser Postgres role (see docs/architecture/milestone-1-foundations.md)
# so Row-Level Security policies actually apply -- Postgres superusers/BYPASSRLS roles
# silently ignore RLS regardless of FORCE ROW LEVEL SECURITY, which would make it a no-op.
DATABASE_URL=postgresql+asyncpg://mnemo_app@localhost/mnemo_dev
SESSION_COOKIE_NAME=mnemo_session
SESSION_TTL_SECONDS=604800
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# OpenRouter (https://openrouter.ai) powers grounded Q&A (/ask). Get an API key from
# https://openrouter.ai/keys, and select a primary model slug -- plus, optionally, one
# or more fallback slugs OpenRouter will try in order if the primary is rate-limited or
# down -- from the current catalog at https://openrouter.ai/models. No defaults are set
# here deliberately: valid model slugs change over time, so a hardcoded example could
# go stale or be wrong. /ask returns a clear "not configured" error until these are set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=[]

# How long a memory summary (app/models/memory.py) stays surfaced before automatic
# expiry -- see docs/architecture/milestone-1-foundations.md for the "forgetting" design.
MEMORY_TTL_DAYS=30

# Escape hatch for corporate networks whose TLS-intercepting proxy issues certificates
# the Python trust store doesn't recognize, which otherwise makes the Hugging Face
# model download at startup fail with an SSL error. Leave unset/true unless you hit
# this -- setting to false disables certificate verification for Hugging Face
# downloads, so only do it on a trusted local/dev network.
HF_SSL_VERIFY=true
